# Crypsor — Environment Variables
# Copy to .env for local/Replit, or set in Render (API) and Vercel (frontend).

# ── Shared (Render API service) ───────────────────────────────────────────────

# PostgreSQL connection string (Aiven or any Postgres provider)
AIVEN_DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Redis connection string (Aiven or any Redis provider — rediss:// for TLS)
AIVEN_REDIS_URL=rediss://user:password@host:port

# Helius API key — Solana RPC + enhanced transaction API
# https://dev.helius.xyz/
HELIUS_API_KEY=your-helius-api-key

# GMGN token data API key
GMGN_API_KEY=your-gmgn-api-key

# Comma-separated list of proxy URLs for GMGN requests (optional)
GMGN_PROXIES=http://proxy1:port,http://proxy2:port

# Express session signing secret (any long random string)
SESSION_SECRET=your-session-secret

# Comma-separated frontend origins allowed by CORS (Vercel URL after deploy)
# Example: https://crypsor.vercel.app,http://localhost:3000
CORS_ORIGIN=https://your-app.vercel.app

# ── Frontend (Vercel build-time) ──────────────────────────────────────────────

# Render API public URL (no trailing slash). Used by the SPA for REST + SSE.
# Example: https://crypsor-api.onrender.com
VITE_API_URL=https://your-api.onrender.com

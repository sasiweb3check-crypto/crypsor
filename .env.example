# Enter secret values in Render environment settings; do not commit them.
AIVEN_DATABASE_URL=
HELIUS_API_KEY=
# Optional PEM certificate from the Aiven service if its CA is not publicly trusted.
AIVEN_CA_CERT=
# Optional durable broker; without it PostgreSQL processes the durable job queue.
REDIS_URL=
PROCESS_ROLE=all
PG_POOL_MAX=2
# Optional Helius enhanced webhook Authorization value (not a wallet password).
HELIUS_WEBHOOK_SECRET=
WALLET_CONCURRENCY=4
HELIUS_RPS=3
DEXSCREENER_RPS=2
SOLANA_RPC_RPS=1
# Optional S3-compatible archive, with credentials entered securely in deployment settings.
ARCHIVE_BUCKET=
AWS_REGION=us-east-1
ARCHIVE_ENDPOINT=

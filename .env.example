# Crypsor — Environment Variables
# Copy to .env for local, or set in Render (Blueprint prompts / Environment).

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL (Aiven or any Postgres). Required for API + pipeline.
AIVEN_DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
# DATABASE_URL=postgres://...   # also accepted as an alias

# Redis (optional). Pipeline uses an in-process queue; set only for BullMQ later.
# AIVEN_REDIS_URL=rediss://user:password@host:port

# ── Solana / intel APIs ───────────────────────────────────────────────────────

# Helius — Solana RPC + enhanced transactions
# https://dev.helius.xyz/
HELIUS_API_KEY=your-helius-api-key
# Optional project UUID for credit checks (also savable in Settings UI)
# HELIUS_PROJECT_ID=your-project-uuid

# GMGN Official OpenAPI — https://gmgn.ai/ai  (header X-APIKEY)
GMGN_API_KEY=your-gmgn-api-key
# GMGN_PROXIES=http://user:pass@proxy1:port
# GMGN_OPENAPI_HOST=https://openapi.gmgn.ai

# ── App / Render ──────────────────────────────────────────────────────────────

SESSION_SECRET=your-session-secret

# Protect /api/cron/tick when using an external free cron (cron-job.org).
# Render Starter is always-on — this is optional. Needed on the free instance.
CRON_SECRET=generate-a-long-random-string

# Optional — comma-separated extra browser origins for CORS.
# Same-origin Render deploy does not need this.
# CORS_ORIGIN=https://your-custom-domain.com,http://localhost:3000

# Optional override for the Vite build output directory (Render start cwd is repo root).
# WEB_DIST=artifacts/crypsor/dist/public

# Telegram push default (bot token / chat id live in Settings UI)
TELEGRAM_PUSH_ENABLED=true

# ── Frontend build ────────────────────────────────────────────────────────────

# Same-origin deploy (Render / Vercel): omit VITE_API_URL (desk calls /api).
# Split API host only:
# VITE_API_URL=https://your-api.example.com

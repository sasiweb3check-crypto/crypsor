# Names only. Supply secret values through secure environment settings.
DATABASE_URL=
# Optional existing Aiven URL takes precedence; remote TLS always verifies.
AIVEN_DATABASE_URL=
AIVEN_CA_CERT=
HUNTER_API_TOKEN=
PORT=3000
PROCESS_ROLE=all
PG_POOL_MAX=2

# Always-on Cloudflare ingress: exact Authorization header configured at Helius.
HELIUS_WEBHOOK_SECRET=
HELIUS_API_KEY=
JUPITER_API_KEY=

# Real delivery is an explicit opt-in; allow exactly one chat.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional AI: no requests unless both flags and key are supplied.
GEMINI_ENABLED=false
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_PER_TOKEN_REQUEST_CAP=1

# Attempts, including failures, count against these application request caps.
# These are conservative local defaults, NOT verified vendor plan quotas.
HELIUS_DAILY_REQUEST_CAP=500
HELIUS_MONTHLY_REQUEST_CAP=10000
DEXSCREENER_DAILY_REQUEST_CAP=300
DEXSCREENER_MONTHLY_REQUEST_CAP=6000
JUPITER_DAILY_REQUEST_CAP=100
JUPITER_MONTHLY_REQUEST_CAP=2000
TELEGRAM_DAILY_REQUEST_CAP=100
TELEGRAM_MONTHLY_REQUEST_CAP=2000
GEMINI_DAILY_REQUEST_CAP=10
GEMINI_MONTHLY_REQUEST_CAP=100
